{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": ".",
          "files": ["OFAuth/OFAuth.csproj", "OFAuth.AspNetCore/OFAuth.AspNetCore.csproj"]
        }
      ],
      "dest": "obj/docfx/api",
      "memberLayout": "separatePages"
    }
  ],
  "build": {
    "content": [
      { "files": ["**/*.yml"], "src": "obj/docfx/api", "dest": "api" },
      { "files": ["index.md", "toc.yml"], "src": "docfx" },
      { "files": ["README.md"] }
    ],
    "output": "docs",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "OFAuth C# SDK",
      "_appTitle": "OFAuth C# SDK",
      "_enableSearch": true
    }
  }
}
